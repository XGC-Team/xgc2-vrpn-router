+// XGC profile is Linux-only. Product startup resolves configured DNS names
+// with c-ares before entering native VRPN; peer advertisements must be numeric.
+unsigned vrpn_xgc_native_profile() { return VRPN_XGC_NATIVE_PROFILE; }
+namespace {
+using XgcClock = std::chrono::steady_clock;
+const std::chrono::milliseconds xgc_peer_budget(3000);
+bool xgc_pending_error() { return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR; }
+// 0 complete, 1 incomplete, -1 peer failure; at most one nonblocking syscall.
+int xgc_receive(int fd, char* output, size_t size, size_t& progress) {
+    if (progress == size) return 0;
+    const ssize_t count = recv(fd, output + progress, size - progress, MSG_DONTWAIT);
+    if (count > 0) { progress += static_cast<size_t>(count); return progress == size ? 0 : 1; }
+    if (count < 0 && xgc_pending_error()) return 1;
+    return -1;
+}
+int xgc_send(int fd, const char* input, size_t size, size_t& progress) {
+    if (progress == size) return 0;
+    const ssize_t count = send(fd, input + progress, size - progress, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (count > 0) { progress += static_cast<size_t>(count); return progress == size ? 0 : 1; }
+    if (count < 0 && xgc_pending_error()) return 1;
+    return -1;
+}
+bool xgc_expired(XgcClock::time_point deadline) {
+    return deadline != XgcClock::time_point{} && XgcClock::now() >= deadline;
+}
+}
